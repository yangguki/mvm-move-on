generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  hq_admin
  store_admin

  @@map("account_role")
}

enum AccountStatus {
  invited
  active
  disabled

  @@map("account_status")
}

model Account {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String         @unique
  passwordHash String         @map("password_hash")
  displayName  String?        @map("display_name")
  role         AccountRole
  status       AccountStatus  @default(invited)
  tokenVersion Int            @default(0) @map("token_version")
  lastLoginAt  DateTime?      @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  stores       AccountStore[]

  @@map("accounts")
}

model Store {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  code      String           @unique
  isActive  Boolean          @default(true) @map("is_active")
  programId String?          @map("program_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  devices   Device[]
  accounts  AccountStore[]
  pairings  PairingSession[]
  program   Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@map("stores")
}

model Skin {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique
  name         String
  description  String?
  tone         String
  thumbnailUrl String?  @map("thumbnail_url")
  tokens       Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  isBuiltin    Boolean  @default(false) @map("is_builtin")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  devices      Device[]

  @@map("skins")
}

model Device {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  skinId        String   @map("skin_id") @db.Uuid
  name          String
  code          String   @unique
  status        String
  statusLabel   String   @map("status_label")
  playing       String?
  progress      Int?
  appVersion    String   @map("app_version")
  versionWarn   Boolean  @default(false) @map("version_warn")
  seenLabel     String   @map("seen_label")
  seenAlert     Boolean  @default(false) @map("seen_alert")
  guide         Boolean  @default(false)
  offline       Boolean  @default(false)
  videoLoopMode String   @default("ab") @map("video_loop_mode")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  store         Store    @relation(fields: [storeId], references: [id])
  skin          Skin     @relation(fields: [skinId], references: [id])

  @@map("devices")
}

enum VideoStatus {
  uploading
  processing
  ready
  failed

  @@map("video_status")
}

enum VideoSourceType {
  url
  upload

  @@map("video_source_type")
}

model Video {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  url          String
  durationSec  Int             @map("duration_sec")
  thumbnailUrl String          @map("thumbnail_url")
  width        Int
  height       Int
  status       VideoStatus     @default(ready)
  sourceType   VideoSourceType @default(url) @map("source_type")
  error        String?
  sizeBytes    Int?            @map("size_bytes")
  storageKey   String?         @map("storage_key")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("videos")
}

model AudioAsset {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  kind        String
  url         String
  durationSec Int      @map("duration_sec")
  mimeType    String   @map("mime_type")
  storageKey  String?  @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("audio_assets")
}

model VoicePack {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  cues      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("voice_packs")
}

model Program {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  status           String
  draft            Json
  draftUpdatedAt   DateTime         @default(now()) @map("draft_updated_at") @db.Timestamptz(3)
  publishedVersion Int?             @map("published_version")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  versions         ProgramVersion[]
  stores           Store[]

  @@map("programs")
}

model ProgramVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId   String   @map("program_id") @db.Uuid
  version     Int
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  snapshot    Json
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, version])
  @@map("program_versions")
}

model AccountStore {
  accountId String  @map("account_id") @db.Uuid
  storeId   String  @map("store_id") @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([accountId, storeId])
  @@map("account_stores")
}

model PairingSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String?   @map("store_id") @db.Uuid
  code       String    @unique
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(3)
  deviceId   String?   @map("device_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  store      Store?    @relation(fields: [storeId], references: [id])

  @@map("pairing_sessions")
}
